# SongSnag configuration. Copy to .env and fill in. Never commit .env.
#
# META_APP_SECRET and META_VERIFY_TOKEN are required to start. The service
# itself (reading reels, Spotify, DM replies) switches on only when all of
# these are set too: IG_ACCESS_TOKEN, IG_ACCOUNT_ID, SPOTIFY_CLIENT_ID,
# SPOTIFY_CLIENT_SECRET, BASE_URL, TOKEN_ENCRYPTION_KEY, ANTHROPIC_API_KEY.
# Until then the server logs webhooks and answers nobody; its first log line
# names what is missing.

# --- Meta / Instagram ------------------------------------------------------

# App ID from the Meta App Dashboard. Not used by the code yet; kept for reference.
META_APP_ID=

# App secret from the Meta App Dashboard: App settings > Basic.
# Used to verify the X-Hub-Signature-256 header on webhook deliveries.
META_APP_SECRET=

# Any random string. You paste the same value into the dashboard's
# "Verify token" field when configuring the webhook callback URL.
META_VERIFY_TOKEN=

# Access token for the SongSnag professional account, from
# "API setup with Unified login" > Generate access tokens in the App Dashboard.
# The dashboard shows it only once.
IG_ACCESS_TOKEN=

# The professional account's ID, as printed by `npm run ig:subscribe`.
IG_ACCOUNT_ID=

# The account's handle, without the @. Read from here, never hardcoded.
IG_HANDLE=

# --- Spotify ---------------------------------------------------------------

# Client ID and secret of the app at https://developer.spotify.com/dashboard.
# The app's redirect URI must be exactly <BASE_URL>/auth/spotify/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Song recognition ------------------------------------------------------

# Claude reads the reel's caption and video frames and lists the songs named.
ANTHROPIC_API_KEY=

# OpenAI transcribes the speech in the reel. Without it, speech is skipped.
OPENAI_API_KEY=

# --- Server ----------------------------------------------------------------

# Public base URL of this server, no trailing slash. Links sent in DMs and
# the Spotify redirect URI are built from it.
# Production: https://api.songsnag.com. Local dev: your tunnel URL.
BASE_URL=

# 32 random bytes, base64. Encrypts Spotify tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Address shown on the privacy, terms and data-deletion pages for requests.
# If empty, those pages tell people to message the account instead.
CONTACT_EMAIL=

# Optional. The SQLite file. Defaults to data/songsnag.db; the Docker image
# sets /data/songsnag.db, where a volume should be mounted.
DATABASE_PATH=

# Optional. Defaults to 3000.
PORT=3000

# --- Local dev only --------------------------------------------------------

# If set, every verified webhook body is written verbatim to this directory.
# Leave unset in production.
CAPTURE_DIR=captures
